{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oriel.invalid/api/1.0/schemas/event.json",
  "title": "Oriel 1.0 stream event",
  "type": "object",
  "additionalProperties": true,
  "required": ["api_version", "type", "request_id", "session_id", "trace_id", "context_generation", "seq"],
  "properties": {
    "api_version": {"const": "1.0"},
    "type": {"enum": ["accepted", "ack", "content_delta", "proposal", "validation", "action_state", "error", "terminal"]},
    "request_id": {"$ref": "common.json#/$defs/opaque_id"},
    "session_id": {"$ref": "common.json#/$defs/opaque_id"},
    "trace_id": {"$ref": "common.json#/$defs/opaque_id"},
    "context_generation": {"type": "integer", "minimum": 0},
    "seq": {"type": "integer", "minimum": 1},
    "message": {"const": "Work is continuing."},
    "content": {"type": "string", "maxLength": 65536},
    "proposal": {"oneOf": [{"$ref": "proposal.json"}, {"$ref": "ha-proposal.json"}]},
    "preview": {"$ref": "ha-preview.json"},
    "outcome": {"enum": ["completed", "denied", "failed", "cancelled", "outcome_unknown"]},
    "error": {"$ref": "error.json#/properties/error"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "content_delta"}}}, "then": {"required": ["content"]}},
    {"if": {"properties": {"type": {"const": "proposal"}}}, "then": {"required": ["proposal"]}},
    {"if": {"properties": {"type": {"const": "validation"}}}, "then": {"required": ["preview"]}, "else": {"not": {"required": ["preview"]}}},
    {"if": {"properties": {"type": {"const": "error"}}}, "then": {"required": ["error"]}},
    {"if": {"properties": {"type": {"const": "terminal"}}}, "then": {"required": ["outcome"]}},
    {"if": {"properties": {"type": {"const": "ack"}}}, "then": {"required": ["message"], "properties": {"api_version": {}, "type": {}, "request_id": {}, "session_id": {}, "trace_id": {}, "context_generation": {}, "seq": {}, "message": {"const": "Work is continuing."}}, "additionalProperties": false, "not": {"anyOf": [{"required": ["content"]}, {"required": ["proposal"]}, {"required": ["error"]}, {"required": ["outcome"]}]}}, "else": {"not": {"required": ["message"]}}}
  ]
}
